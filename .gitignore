# 빌드 산출물 — 로컬 절대 경로(사용자명)가 들어간다
bin/
obj/
[Dd]ebug/
[Rr]elease/
publish/
*.pdb

# IDE
.vs/
.idea/
.vscode/
*.user
*.suo
*.DotSettings.user

# 테스트·패키지
TestResults/
*.nupkg

# OS
Thumbs.db
Desktop.ini
.DS_Store

# 로컬 Claude 설정 — 이 PC 경로가 들어간 실행 설정·잠금 파일뿐이라 폴더째 뺀다
#   단, 프로젝트 스킬(.claude/skills/)은 다른 PC·맥에서도 쓰도록 올린다
/.claude/*
!/.claude/skills/

# 루트 tools/는 로컬 작업용. 앞의 /가 없으면 저장소에 올라가 있는 app/tools/까지 막힌다
/tools/

# 쓰레드 프로필 사진 같은 개인 홍보 자료 — 앱과 상관없어 이 PC에만 둔다
/promo/
